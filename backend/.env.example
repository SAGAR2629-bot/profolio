# Environment (development / production)
ENVIRONMENT=production

# Security - IMPORTANT: Set a strong random secret and admin password in production!
JWT_SECRET=generate-a-strong-random-64-char-string-here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password

# Allowed CORS Origins (comma-separated, e.g. https://anandsagar.dev,https://admin.anandsagar.dev)
CORS_ORIGINS=https://anandsagar.dev,https://admin.anandsagar.dev

# Database: SQLite by default, or PostgreSQL connection string
# DATABASE_URL=sqlite:///./portfolio.db
# DATABASE_URL=postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./portfolio.db
